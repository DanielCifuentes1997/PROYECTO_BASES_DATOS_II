# Copie este archivo como .env (en esta misma carpeta) y escriba la clave real.
# El archivo .env no se sube al repositorio.

# Cadena de conexion a la base conectable del proyecto
ORACLE_DSN=localhost:1521/XEPDB1

# Usuario del portal del huesped, creado en el script 12 con el rol ROL_PORTAL_WEB.
# Solo ve el catalogo y solo puede cotizar, registrarse y reservar.
PORTAL_USUARIO=portal_web
PORTAL_CLAVE=escriba_aqui_la_clave
